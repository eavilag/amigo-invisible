// Configuración del Worker de Cloudflare (ADR-0002, ADR-0003, ADR-0011, ADR-0012).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reyes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Todas las peticiones pasan por el Worker para aplicar cabeceras de seguridad (ADR-0011).
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amigo-invisible",
      // Base de datos de producción (región WEUR). El ID no es secreto: sin credenciales no da acceso.
      "database_id": "db8f1960-24f1-461e-9dbd-f30fab7ef57d",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
  ],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
}
