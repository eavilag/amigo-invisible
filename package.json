{
  "name": "amigo-invisible",
  "version": "0.1.0",
  "private": true,
  "description": "Amigo invisible por WhatsApp, fácil para personas mayores",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project worker",
    "test:e2e": "playwright test",
    "test:prod": "playwright test --config playwright.prod.config.ts",
    "test:all": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json && playwright test",
    "traceability": "node scripts/traceability.mjs",
    "db:migrate:local": "wrangler d1 migrations apply amigo-invisible --local",
    "db:migrate:remote": "wrangler d1 migrations apply amigo-invisible --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "preview:local": "npm run build && wrangler d1 migrations apply amigo-invisible --local && vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "~5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "~4.1.11",
    "wrangler": "^4.149.0"
  }
}
